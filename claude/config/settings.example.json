{
  "_comment": "Drop these blocks into ~/.claude/settings.json under hooks. The install script merges with your existing settings (preserving any other hooks you already have).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/user_prompt_submit.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/session_start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/post_tool.py",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/mimo_audit.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/stop_orchestrator.py",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/trident_notify.py",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
