{
  "_comment": "Drop these blocks into ~/.claude/settings.json under hooks. The install script merges with your existing settings (preserving any other hooks you already have). Slimmed 2026-10-17 (Dom): only the PreToolUse guards remain.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/deploy_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/live_hooks_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/domininclynch/.claude/hooks/ask_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
